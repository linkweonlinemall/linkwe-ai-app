# Copy to ".env" for local development:
#   cp .env.example .env
#
# Next.js loads .env automatically (restart `npm run dev` after changes).

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- App URL fallback (client-exposed) ---
# Used by lib/app-base-url.ts if NEXT_PUBLIC_BASE_URL is unset.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

# --- Local PostgreSQL (development) ---
# Replace YOUR_MAC_USERNAME with the output of: whoami
# Replace linkwe_dev with your database name if different.
# No password is common for local Homebrew Postgres (same OS user = trusted).
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/linkwe_dev"

# DIRECT_URL — non-pooled connection, required for prisma migrate.
# Local: same as DATABASE_URL (localhost has no pooler).
# Production (Neon): the DIRECT connection string (hostname WITHOUT -pooler).
DIRECT_URL="postgresql://USER@localhost:5432/linkwe_dev"

# If you created a dedicated DB user with a password, use:
# DATABASE_URL="postgresql://linkwe:your_password_here@localhost:5432/linkwe_dev"

# --- Production (Supabase) — use on hosting / CI, not for local dev while pooler/direct DB is blocked ---
# DATABASE_URL="postgresql://postgres.[ref]:[password]@[host]:5432/postgres"

# --- Auth ---
# Session/JWT signing secret. Must be at least 32 characters.
AUTH_SECRET="generate-a-random-32-plus-char-string"

# --- Google sign-in (server-only OAuth web client) ---
# Authorized redirect URI: https://www.linkweonlinemall.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Signing secret from Stripe Dashboard → Developers → Webhooks → your endpoint
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# --- Cron (Vercel hourly auto-complete for bookings & orders) ---
# Generate: openssl rand -hex 32
CRON_SECRET=

# --- AI (Anthropic / Rex + Zara) ---
ANTHROPIC_API_KEY="sk-ant-xxxxxxxx"

# --- Email (Resend) ---
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="noreply@linkweonlinemall.com"

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Maps / Places (client-exposed) ---
NEXT_PUBLIC_MAPBOX_TOKEN="pk.xxxxxxxx"
NEXT_PUBLIC_GOOGLE_PLACES_KEY="xxxxxxxx"
